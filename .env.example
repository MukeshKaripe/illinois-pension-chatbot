# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.6-luna-1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Azure AI Search
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=pension-code-dev

# Database
PGHOST=
PGUSER=
PGPORT=5432
PGDATABASE=pension_chat_db
PGPASSWORD=

# JWT Auth
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Employee records (Phase 1) ─────────────────────────────────
# "pbms" reads employee records live, read-only, from the fund's SQL Server
# (PBMS); "postgres" keeps the original profile path. The read-only login the
# client issues replaces these credentials with no code change.
RECORD_SOURCE=postgres
# Where conversation state lives between turns: postgres (default; survives
# restarts, any number of workers) or memory (one worker, lost on restart; saves
# ~2-3 s a turn when the database is far away, e.g. a laptop demo).
CHECKPOINTER=postgres
PBMS_SQL_SERVER=
PBMS_SQL_DATABASE=
PBMS_SQL_USER=
PBMS_SQL_PASSWORD=
